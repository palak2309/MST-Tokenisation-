# Select exactly one profile: testnet or mainnet.
VITE_MST_NETWORK=testnet

# MST Testnet profile
VITE_MST_TESTNET_NETWORK_NAME=MST Testnet
VITE_MST_TESTNET_CHAIN_ID=91562037
VITE_MST_TESTNET_RPC_URL=https://testnetrpc.mstblockchain.com
VITE_MST_TESTNET_CONTRACT_ADDRESS=0x6883929b0A46dC2f301D294719954313b979dc14
# PropertyToken contract address on MST Testnet
VITE_MST_TESTNET_TOKEN_CONTRACT_ADDRESS=0x681Ef61D12372e040EE5f6e058932818aA29407F
VITE_MST_TESTNET_EXPLORER_URL=https://testnet.mstscan.com/

# MST Mainnet profile. Select with VITE_MST_NETWORK=mainnet or use the UI network switcher.
VITE_MST_MAINNET_NETWORK_NAME=MST Mainnet
VITE_MST_MAINNET_CHAIN_ID=4646
VITE_MST_MAINNET_RPC_URL=https://mariorpc.mstblockchain.com/
# Deployed MST Mainnet contract addresses
VITE_MST_MAINNET_CONTRACT_ADDRESS=0x681Ef61D12372e040EE5f6e058932818aA29407F
VITE_MST_MAINNET_TOKEN_CONTRACT_ADDRESS=0x39985d784615f307D34B8143768a54bEEaB94537
VITE_MST_MAINNET_EXPLORER_URL=https://mstscan.com/

# Never put private keys, seed phrases, or wallet credentials in VITE_* variables.
# Deployment credentials belong only in a local, ignored deployment environment.
